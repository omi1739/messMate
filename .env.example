# Copy to .env and fill in real values. Never commit real secrets.
# (Next.js loads .env here; the helper scripts in scripts/ read the same file.)

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/messmate?retryWrites=true&w=majority"

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# --- Super admin -----------------------------------------------------------
# Credentials for the separate /admin-login page. These are not stored in the
# database; changing them takes effect immediately.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

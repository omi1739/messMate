# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Secrets
#
# Nothing in this block should ever be committed. A credential that reaches git
# stays in the history even after it is deleted from the working tree, so these
# patterns are deliberately broad — a false positive costs one `git add -f`, a
# false negative costs a rotated key.
# ---------------------------------------------------------------------------

# Environment files. Covers .env, .env.local, .env.production, .env.staging, .env.*.local
.env*
# ...except the committed template, which is the whole point of committing env config.
!.env.example

# Keys, certificates and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.ovpn
*.crt
*.cer
*.der
*.asc
id_rsa
id_rsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*

# Cloud and package-manager credentials
credentials.json
service-account*.json
*service-account*.json
firebase-adminsdk*.json
.aws/
.gcloud/
.netrc
.pgpass
.my.cnf
.npmrc
.yarnrc.yml
# Terraform state can contain cleartext credentials
*.tfstate
*.tfstate.*

# Common secret directories
secrets/
.secret/
.private/

# Anything that looks like a credential file, wherever it lives
**/*secret*.json
**/*credentials*.json
**/*.secret.*


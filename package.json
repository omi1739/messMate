{
  "name": "messmate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./scripts/register.mjs scripts/run-tests.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:dark": "node scripts/check-dark.mjs",
    "check:shots": "node scripts/check-shots.mjs",
    "shoot:demo": "node --import ./scripts/register.mjs scripts/shoot-demo.mjs",
    "test:isolation": "node scripts/check-isolation.mjs",
    "test:auth": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-auth.ps1",
    "test:routing": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-routing.ps1",
    "check:meals-ui": "node scripts/check-meals-ui.mjs",
    "check:finance-ui": "node scripts/check-finance-ui.mjs",
    "test:integration": "npm run db:seed:e2e && npm run db:seed:demo && npm run test:isolation && npm run test:auth && npm run test:routing && npm run check:meals-ui && npm run check:finance-ui",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed:e2e": "node --import ./scripts/register.mjs scripts/seed-probe.mjs",
    "db:seed:demo": "node --import ./scripts/register.mjs scripts/seed-demo.mjs",
    "db:clean:e2e": "node --import ./scripts/register.mjs scripts/clean-e2e.mjs",
    "db:check": "node --import ./scripts/register.mjs scripts/check-integrity.mjs",
    "db:seed:visits": "node --import ./scripts/register.mjs scripts/visits.mjs seed 30",
    "db:reset:visits": "node --import ./scripts/register.mjs scripts/visits.mjs reset",
    "db:prune:visits": "node --import ./scripts/register.mjs scripts/visits.mjs prune"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "next": "^16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
